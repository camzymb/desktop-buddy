# Desktop Buddy — environment variables.
#
# COPY this file to ".env" (same folder) and fill in your real values.
# ".env" is gitignored, so your keys stay on your machine and are never committed.

# --- Anthropic API key (shared) ---

# Your Anthropic API key. Used by BOTH the Weekly Content Planner (to research
# and draft the plan) and the email-draft assistant (to draft replies you review
# and send yourself). One key covers both.
# Get one at https://console.anthropic.com/  →  API keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Your Notion internal-integration token, used to write the full plan to Notion.
# Create one at https://www.notion.so/my-integrations (it starts with "ntn_").
NOTION_TOKEN=ntn_your-notion-token-here

# The Notion page to write the plan to (its 32-character id, from the page URL).
# Remember to share that page with your integration:
#   open the page → ••• (top-right) → Connections → add your integration.
NOTION_PAGE_ID=your-notion-page-id-here

# --- Morning Brief ---

# Fallback city for the morning weather line, used only when locating you from
# your IP fails (e.g. on a VPN). Optional — leave as-is to default to Oslo.
WEATHER_DEFAULT_CITY=Oslo
