# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/

# Secrets, credentials & personal data (KEEP PRIVATE DATA OUT OF GITHUB!)
# Real values live in a local .env; commit only .env.example with placeholders.
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
credentials*.json
token.json
token*.json
client_secret.json
client_secret*.json

# OS files
.DS_Store
Thumbs.db
*.swp

# IDE
.vscode/
.idea/

# Audacity project files (we only commit the exported MP3s)
*.aup3
*.aup3-shm
*.aup3-wal

# Logs
*.log

# Local app state (e.g. remembered panel positions, last morning-brief date) —
# machine-specific, never shared
panel_state.json
plan_panel_state.json
brief_state.json

# Generated weekly content plan — your own content ideas, kept local (the full
# plan lives in Notion); regenerated on demand, never committed.
weekly_plan.json

# Private planning docs — keep out of the public repo
docs/content-planner-spec.md
